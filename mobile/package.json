    "expo-media-library": "~57.0.4",
    "expo-network": "~57.0.1",
    "expo-sharing": "~57.0.15",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "~5.7.0",
